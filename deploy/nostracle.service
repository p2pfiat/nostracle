[Unit]
Description=nostracle DLC price oracle
After=network-online.target
Wants=network-online.target

[Service]
User=nostracle
WorkingDirectory=/var/lib/nostracle
ExecStart=/usr/local/bin/nostracle -c /var/lib/nostracle/config.toml run
Restart=always
RestartSec=10
# hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/nostracle

[Install]
WantedBy=multi-user.target
